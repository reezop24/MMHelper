# Telegram bot token (required)
FIBOFBO_FLOW_BOT_TOKEN=

# Optional
FIBOFBO_FLOW_SIGNAL_FILE=/root/mmhelper/db/twelve_data_bot/latest_signal.json
FIBOFBO_FLOW_CANDLES_DB=/root/mmhelper/db/twelve_data_bot/candles.db
FIBOFBO_FLOW_DEFAULT_TF=h1
FIBOFBO_FLOW_PREVIEW_URL=http://194.233.71.34:8766/preview

# MTF scoring engine config
FIBOFBO_FLOW_MTF_SCORE_MIN=7
FIBOFBO_FLOW_MTF_NEAR_END_MIN=45
FIBOFBO_FLOW_DAILY_CONFLICT_MODE=soft
FIBOFBO_FLOW_WEEKLY_CONFLICT_MODE=soft
FIBOFBO_FLOW_MTF_SWING_LOOKBACK=2
FIBOFBO_FLOW_MTF_TREND_SWINGS_N=4

# Impulse engine config
FIBOFBO_FLOW_IMPULSE_SWING_LOOKBACK=2

# Active leg engine config
FIBOFBO_FLOW_ACTIVELEG_H1_OVEREXT=1.2
FIBOFBO_FLOW_ACTIVELEG_M30_OVEREXT=1.5

# Retrace engine config
FIBOFBO_FLOW_RETRACE_ENABLE_SWEEP=1
FIBOFBO_FLOW_RETRACE_SWEEP_READY_DIRECT=1
FIBOFBO_FLOW_RETRACE_SWEEP_REQUIRE_MICRO_CONFIRM=1
FIBOFBO_FLOW_RETRACE_SWEEP_MAX_RECLAIM_CANDLES=3
FIBOFBO_FLOW_RETRACE_SWEEP_TRIGGER_RATIO=0.9

# Anomaly filter
FIBOFBO_FLOW_ANOMALY_FILTER_ENABLED=1
FIBOFBO_FLOW_ANOMALY_RANGE_MULTIPLIER=4.0
FIBOFBO_FLOW_ANOMALY_WICK_MULTIPLIER=2.0
FIBOFBO_FLOW_ANOMALY_MICRO_RANGE_RATIO=0.25

LOG_LEVEL=INFO

# Simulator preview server
SIM_PREVIEW_HOST=0.0.0.0
SIM_PREVIEW_PORT=8766
